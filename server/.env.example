# Backend environment variables for LibrisConnect

# MongoDB connection string
# Example:
# mongodb+srv://username:password@cluster.mongodb.net/libris-connect?retryWrites=true&w=majority
MONGODB_URI=

# Server port
PORT=5000

# Runtime mode
NODE_ENV=development

# JWT signing secret (use a long random value in production)
JWT_SECRET=change-this-to-a-strong-random-secret
